{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://ai-blog-hbur.onrender.com/api/$1" },
    { "source": "/proxy-image", "destination": "https://ai-blog-hbur.onrender.com/proxy-image" },
    { "source": "/uploads/(.*)", "destination": "https://ai-blog-hbur.onrender.com/uploads/$1" },
    { "source": "/feed.xml", "destination": "https://ai-blog-hbur.onrender.com/feed.xml" },
    { "source": "/sitemap.xml", "destination": "https://ai-blog-hbur.onrender.com/sitemap.xml" },
    { "source": "/login", "destination": "/login/index.html" },
    { "source": "/register", "destination": "/register/index.html" },
    { "source": "/forgot-password", "destination": "/forgot-password/index.html" },
    { "source": "/reset-password", "destination": "/reset-password/index.html" },
    { "source": "/verify-email", "destination": "/verify-email/index.html" },
    { "source": "/account", "destination": "/account/index.html" },
    { "source": "/admin/login", "destination": "/admin/login/index.html" },
    { "source": "/admin/dashboard", "destination": "/admin/dashboard/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
