BLOG_API_BASE=http://127.0.0.1:8000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional development fallbacks shared with the backend
# DEV_ADMIN_USERNAME=admin
# DEV_ADMIN_PASSWORD=admin123

# 说明：LLM 与生图密钥已全部上收到后端（后台 AI Provider / Render 环境变量），
# scripts/ 不再读取 SILICONFLOW_* 或 XAI_API_KEY，请勿在此重新引入。

# Canonical host，供 smoke-check.mjs 校验公开站点
PUBLIC_SITE_URL=http://127.0.0.1:5173

# 发布完成后触发 Vercel 重新构建（auto-blog.mjs）
# VERCEL_DEPLOY_HOOK_URL=

# R2/CDN 公开域名。repair-post-media.mjs 用它构造"已本地化图片"的可信 host 集合；
# 缺失时会退化成硬编码域名，把已本地化的图片当第三方图重新下载上传。
# R2_PUBLIC_BASE_URL=https://img.563118077.xyz

# Optional automation/runtime config
# AUTO_BLOG_CONFIG_PATH=./config/auto-blog.config.json
# AUTO_BLOG_SERIES_RULES_PATH=./config/series-assignment.rules.json
# AUTO_BLOG_TOPIC_PRESENTATION_RULES_PATH=./config/topic-presentation.rules.json
